{
  "name": "minicraft",
  "version": "0.1.0",
  "description": "Mi propia version de Minecraft (Electron + Three.js)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/run.js",
    "captura": "electron test/captura.js",
    "empaquetar": "electron-builder --win",
    "empaquetar:carpeta": "electron-builder --win --dir",
    "probar-empaquetado": "node tools/probar-empaquetado.js"
  },
  "dependencies": {
    "three": "0.149.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "author": "Max",
  "build": {
    "appId": "com.minicraft.juego",
    "productName": "MiniCraft",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "guardado-main.js",
      "src/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/package.json",
      "!node_modules/three/src/**",
      "!node_modules/three/examples/**",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.js",
      "!node_modules/three/build/three.min.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MiniCraft",
      "artifactName": "MiniCraft-Setup-${version}.exe"
    }
  }
}
